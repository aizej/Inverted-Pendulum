<mujoco model="knob">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="RK4"/>
  <worldbody>
    <light name="top" pos="0 0 2"/>

    <body name="pivot" pos="0 0 0">
      <geom type="sphere" size="0.02" mass="0.04" rgba="0 0 0 1"/>

      <body name="link1" pos="0 0 0">
        <joint name="joint1" type="hinge" axis="0 1 0" range="-3.141592 3.141592"/>
        <geom name="rod1" type="capsule" fromto="0 0 0  0 0 -0.5"
              size="0.04" rgba="0.2 0.5 0.9 1" mass="0.04"/>

        <body name="tip" pos="0 0 -0.5">
          <geom type="sphere" size="0.04" rgba="1 1 0 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="torque1" joint="joint1" gear="1" ctrlrange="-5 5"/>
  </actuator>

  <keyframe>
    <key name="hanging" qpos="0" ctrl="0"/>
    <key name="setpoint1" qpos="-1.308996939" ctrl="0"/>
    <key name="setpoint2" qpos="-1.570796326" ctrl="0"/>
    <key name="setpoint3" qpos="-1.832595714" ctrl="0"/>
  </keyframe>
</mujoco>