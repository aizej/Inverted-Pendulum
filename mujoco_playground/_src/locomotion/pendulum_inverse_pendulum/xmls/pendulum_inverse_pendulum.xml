<mujoco model="double_pendulum">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="RK4"/>
  <worldbody>
    <light name="top" pos="0 0 2"/>
  

    <body name="pivot" pos="0 0 0">
      <geom type="sphere" size="0.03" mass="0.03" rgba="0 0 0 1"/>

      <body name="link1" pos="0 0 0">
        <joint name="joint1" type="hinge" axis="0 1 0" range="-3.141592 3.141592" damping="0.0003" frictionloss="0.00002"/>
        <geom name="rod1" type="capsule" fromto="0 0 0  0 0 -0.5"
              size="0.08" rgba="0.2 0.5 0.9 1" mass="0.005"/>

        <body name="link1_tip" pos="0 0 -0.5">
          <geom type="sphere" size="0.04" rgba="1 1 0 1" mass="0.0045"/>

          <body name="link2" pos="0 0 -0.5">
            <joint name="joint2" type="hinge" axis="0 1 0" damping="0.0005" frictionloss="0.00001" />
            <geom name="rod2" type="capsule" fromto="0 0 0  0 0 -0.5"
                  size="0.08" rgba="0.9 0.3 0.2 1" mass="0.003"/>

            <body name="tip" pos="0 0 -0.5">
              <geom type="sphere" size="0.04" rgba="1 1 0 1" mass="0.0035"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <sensor>
    <jointpos joint="joint2" name="joint2_angle"/>
  </sensor>

  <actuator>
    <motor name="torque1" joint="joint1" gear="1" ctrlrange="-0.066 0.066"/>  # torque measured about 10g over 0.08m rod equals 0.08 N-m
  </actuator>

  <contact>
    <exclude body1="pivot" body2="link1"/>
    <exclude body1="pivot" body2="tip"/>
    <exclude body1="pivot" body2="link2"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link1" body2="tip"/>
    <exclude body1="link2" body2="tip"/>
    <exclude body1="link1_tip" body2="link2"/>
    <exclude body1="link1_tip" body2="tip"/>
    <exclude body1="link1_tip" body2="link1"/>
    <exclude body1="link1_tip" body2="pivot"/>
  </contact>

  <keyframe>
    <key name="hanging" qpos="0 0" ctrl="0"/>
    <key name="upright" qpos="0 -3.141592" ctrl="0"/>
  </keyframe>
</mujoco>